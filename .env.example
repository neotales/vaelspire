# Vaelspire Core local development configuration
# Copy to .env or run ./scripts/dev-setup.sh to generate automatically.

VAELSPIRE_BIND=127.0.0.1:8080
VAELSPIRE_SQLITE_PATH=.vaelspire/vaelspire.sqlite
VAELSPIRE_TENANT_NAME=default

# 64 lowercase hex characters (32 bytes). Generated via `vaelspire keygen`.
VAELSPIRE_AUTH_KEY=

# Local HTTP development only. Set to false (or omit) behind TLS in production.
VAELSPIRE_INSECURE_HTTP=true

# Optional comma-separated list of allowed Origin headers for state-changing requests.
# Omit to allow localhost / 127.0.0.1 / [::1] on any port.
# VAELSPIRE_ALLOWED_ORIGINS=https://app.example.com

# Enable only behind a trusted reverse proxy (Caddy, Traefik, Nginx) that sets X-Forwarded-For.
VAELSPIRE_TRUST_PROXY=false

# Prefix for issued API keys (1-16 ASCII alphanumeric or '-' chars).
VAELSPIRE_API_KEY_PREFIX=vsp

# Log output format: pretty | json
VAELSPIRE_LOG_FORMAT=pretty

# Initial admin account provisioned idempotently on bootstrap/startup.
VAELSPIRE_ADMIN_EMAIL=admin@vaelspire.local
VAELSPIRE_ADMIN_PASSWORD=change-me-local-dev-password
